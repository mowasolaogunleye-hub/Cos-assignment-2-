public class Fibonacci {
    public static void main(String[] args) {

        int first = 0;
        int second = 1;

        System.out.println("First 100 Fibonacci Numbers:");

        for (int i = 1; i <= 100; i++) {

            System.out.print(first + " ");

            int next = first + second;
            first = second;
            second = next;
        }
    }
}
